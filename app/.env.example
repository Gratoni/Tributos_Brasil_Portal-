# ==============================================================
#  Tributos Brasil — variáveis de ambiente (Vite)
#  Copie para `app/.env.local` e preencha.
# ==============================================================

# ── CMS / API de conteúdo ────────────────────────────────────
# URL base da API de conteúdo (sem barra final ou com barra, ambas funcionam)
# Exemplo: https://cms.tributosbrasil.com.br/api
VITE_NEWS_API_URL=
# Chave secreta para a API (se o backend exigir autenticação Bearer)
VITE_NEWS_API_KEY=
# Provedor de CMS. Use 'strapi' para backends Strapi v5 ou deixe em branco para REST genérico.
# VITE_NEWS_CMS_PROVIDER=strapi

# ── Formulários (newsletter + contato) ───────────────────────
# URL base onde estão as Vercel Functions. Em produção (mesmo domínio) deixe em branco.
# Em dev com frontend separado da API, defina ex: http://localhost:3000
VITE_FORMS_API_URL=

# ── Analytics ────────────────────────────────────────────────
# Google Analytics 4 — ID de medição (ex: G-XXXXXXXXXX)
# Só injetado em produção (VITE_APP_ENV=production). Deixe em branco para desativar.
VITE_GA_MEASUREMENT_ID=

# ── Admin (painel restrito) ──────────────────────────────────
# Usuário para login do painel administrativo.
VITE_ADMIN_USER=admin
# Hash SHA-256 da senha — gere com:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('SUA_SENHA')).then(h=>console.log(Buffer.from(h).toString('hex')))"
# Em produção, use SEMPRE o hash — nunca a senha em texto puro.
VITE_ADMIN_PASSWORD_HASH=
# Senha em texto puro — aceita APENAS em dev (ignorado quando VITE_APP_ENV=production).
# VITE_ADMIN_PASSWORD=

# ── Identidade do site ───────────────────────────────────────
VITE_SITE_URL=https://tributosbrasil.com.br
VITE_APP_ENV=production
VITE_SUPPORT_EMAIL=contato@tributosbrasil.com.br
VITE_SUPPORT_PHONE=+5511957077345
