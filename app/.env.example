# Tributos Brasil Portal — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha os valores

# URL base do site (sem barra no final)
VITE_SITE_URL=https://tributosbrasil.com.br

# Ambiente: development | production
VITE_APP_ENV=production

# Contato
VITE_SUPPORT_EMAIL=contato@tributosbrasil.com.br
VITE_SUPPORT_PHONE=+5511957077345

# Google Analytics (opcional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Chave da API de notícias (para futura integração CMS)
# VITE_NEWS_API_KEY=sua_chave_aqui
# VITE_NEWS_API_URL=https://api.tributosbrasil.com.br
