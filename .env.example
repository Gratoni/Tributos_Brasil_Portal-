# ==============================================================
#  Tributos Brasil — Vercel Functions (backend)
#  Estas variáveis vão em "Environment Variables" no Vercel.
# ==============================================================

# ── Provedor de e-mail / newsletter ──────────────────────────
# OPÇÃO A (recomendada): Brevo (newsletter + transacional)
#   Crie uma API key em https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
#   (Opcional) ID da lista para onde novos inscritos serão enviados.
BREVO_LIST_ID=

# OPÇÃO B: Resend (apenas transacional — o contato funciona,
# mas a newsletter requer Brevo. Deixe em branco se usar Brevo.)
RESEND_API_KEY=

# ── Remetente e destinatário dos e-mails transacionais ───────
# Formato aceito: "Tributos Brasil <noreply@tributosbrasil.com.br>"
MAIL_FROM=Tributos Brasil <noreply@tributosbrasil.com.br>
# Para onde os formulários de contato chegam.
SUPPORT_EMAIL=contato@tributosbrasil.com.br
